# ============================================================
# Openfield — environment variables
# Copy this file to .env.local and fill in every value.
# .env.local is git-ignored and should NEVER be committed.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

# Full public-facing origin (no trailing slash).
# Used to build OAuth redirect URIs and absolute links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ----------------------------------------------------------
# Session security
# iron-session encrypts the session cookie with this key.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
# ----------------------------------------------------------
SESSION_SECRET=change_me_use_at_least_32_random_chars_here

# ----------------------------------------------------------
# Gmail OAuth 2.0
# 1. Go to https://console.cloud.google.com/
# 2. Create (or select) a project
# 3. Enable the Gmail API
# 4. Create OAuth 2.0 credentials (Web application type)
# 5. Add authorized redirect URI:
#      http://localhost:3000/api/auth/callback   (development)
#      https://yourdomain.com/api/auth/callback  (production)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ----------------------------------------------------------
# AI — Anthropic Claude (for draft-reply API route)
# https://console.anthropic.com/
# ----------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
